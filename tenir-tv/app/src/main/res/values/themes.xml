<resources>
    <style name="Theme.Tenir" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="Text" parent="@android:style/TextAppearance.Material">
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Overline">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/gold</item>
    </style>
    <style name="Text.Display">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="Text.Title">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">30sp</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="ServiceField">
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_3</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext|flagNoExtractUi</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minHeight">40dp</item>
    </style>
    <style name="ServiceButton">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
