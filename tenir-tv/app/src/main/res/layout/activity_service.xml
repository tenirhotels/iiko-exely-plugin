<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/pinPanel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/service_title" />
        <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/service_pin" />
        <EditText android:id="@+id/pin" style="@style/ServiceField" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp" android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="numberPassword" android:maxLength="12" />
        <Button android:id="@+id/pinOk" style="@style/ServiceButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/enter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingLeft="40dp"
        android:paddingTop="28dp"
        android:paddingRight="40dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="28dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/service_title" />
                <TextView android:id="@+id/version" style="@style/Text.Caption" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" />

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/service_room" />
                <EditText android:id="@+id/f_room" style="@style/ServiceField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:inputType="text" />

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/service_hub_url" />
                <EditText android:id="@+id/f_hubUrl" style="@style/ServiceField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:inputType="textUri" />

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/service_property" />
                <EditText android:id="@+id/f_propertyCode" style="@style/ServiceField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:inputType="text" />

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/service_token" />
                <EditText android:id="@+id/f_hubToken" style="@style/ServiceField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:inputType="textPassword" />

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/service_content_url" />
                <EditText android:id="@+id/f_contentUrl" style="@style/ServiceField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:inputType="textUri" />

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/service_language" />
                <EditText android:id="@+id/f_language" style="@style/ServiceField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:inputType="text" />

                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/service_new_pin" />
                <EditText android:id="@+id/f_pin" style="@style/ServiceField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:inputType="numberPassword" />
                <CheckBox android:id="@+id/f_demo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/service_demo" android:textColor="@color/text"
                    android:textSize="14sp" />

                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:scrollbars="none">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                    <Button android:id="@+id/b_save" style="@style/ServiceButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/service_save" />
                    <Button android:id="@+id/b_test" style="@style/ServiceButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/service_test" />
                    <Button android:id="@+id/b_reload" style="@style/ServiceButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/service_reload" />
                    <Button android:id="@+id/b_home" style="@style/ServiceButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/service_home" />
                    <Button android:id="@+id/b_settings" style="@style/ServiceButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/service_settings" />
                    <Button android:id="@+id/b_reset" style="@style/ServiceButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/service_reset" />
                    <Button android:id="@+id/b_close" style="@style/ServiceButton" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/service_close" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/statusScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="true"
            android:background="@drawable/field_bg"
            android:padding="14dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_2"
                android:textIsSelectable="false"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
